{
  // Cloudflare Workers config for the OpenNext build. See docs/DEPLOYMENT.md.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opiskelensuomea",
  "main": ".open-next/worker.js",
  // nodejs_compat is required by the adapter; compatibility_date must be >= 2024-09-23.
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
  // Bindings (KV / R2 / D1) are added here as features require them.
}
